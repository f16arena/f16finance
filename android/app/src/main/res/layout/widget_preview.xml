<?xml version="1.0" encoding="utf-8"?>
<!-- Картинка в списке виджетов: так выглядит открытая смена. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="vertical" android:padding="14dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Orda Point" android:textColor="@color/widget_dim" android:textSize="12sp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Смена идёт" android:textColor="@color/widget_text" android:textSize="18sp" android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="46 380 ₸ · 38 чеков" android:textColor="@color/widget_accent" android:textSize="15sp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="За неделю: 84 500 ₸" android:textColor="@color/widget_dim" android:textSize="12sp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:background="@drawable/widget_button_bg"
        android:paddingHorizontal="18dp" android:paddingVertical="6dp"
        android:text="Продать" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
</LinearLayout>
