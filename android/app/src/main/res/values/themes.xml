<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Orda" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/splash_bg</item>
    </style>

    <!-- Заставка: тот же фон, что у приложения, и знак с рисующейся дугой. -->
    <style name="Theme.Orda.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_mark_animated</item>
        <item name="windowSplashScreenAnimationDuration">700</item>
        <item name="postSplashScreenTheme">@style/Theme.Orda</item>
    </style>
</resources>
