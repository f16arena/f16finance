# Orda на cloud-001. Кладётся в /etc/caddy/sites/orda.caddy (Caddyfile делает import sites/*.caddy).
# Включать ТОЛЬКО когда DNS этих имён смотрит на сервер, иначе Caddy будет зря долбить Let's Encrypt.
#
# Поддомены организаций (<slug>.ordaops.kz) получают сертификат по требованию (on-demand TLS).
# Для этого в глобальном блоке /etc/caddy/Caddyfile (самый верх файла) нужно:
#   {
#     on_demand_tls {
#       ask http://127.0.0.1:5555/check
#     }
#   }

# Разрешаем сертификат только для наших поддоменов, чтобы никто не выпустил его на чужое имя.
http://127.0.0.1:5555 {
	@ours expression `{query.domain}.endsWith(".ordaops.kz") || {query.domain} == "ordaops.kz"`
	respond @ours 200
	respond 404
}

db.ordaops.kz {
	reverse_proxy 127.0.0.1:8100
}

ordaops.kz {
	redir https://www.ordaops.kz{uri} permanent
}

www.ordaops.kz {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3200
}

*.ordaops.kz {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy 127.0.0.1:3200
}
