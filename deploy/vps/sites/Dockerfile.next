# Общая сборка для небольших Next-сайтов с Vercel (f16-arena.kz, tournament.f16-arena.kz).
# Репозиторий сайта — контекст сборки; output: 'standalone' в них не включён, поэтому
# запускаем обычный `next start` с node_modules.
ARG NODE_VERSION=22
FROM node:${NODE_VERSION}-bookworm-slim AS build
ARG PM=npm
# lockfile 9.0 — pnpm 9: свежий pnpm (10+) по умолчанию блокирует скрипты установки пакетов.
ARG PNPM_VERSION=9
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
COPY . .
RUN if [ "$PM" = pnpm ]; then pnpm install --no-frozen-lockfile; else npm ci; fi
# Ключи сайта нужны и при сборке (страницы с данными собираются заранее, как на Vercel):
# секрет BuildKit доступен только на этом шаге и в образ не попадает.
RUN --mount=type=secret,id=webenv     if [ -s /run/secrets/webenv ]; then set -a; . /run/secrets/webenv; set +a; fi;     if [ "$PM" = pnpm ]; then pnpm run build; else npm run build; fi

FROM node:${NODE_VERSION}-bookworm-slim AS run
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
COPY --from=build --chown=node:node /app ./
USER node
EXPOSE 3000
CMD ["node_modules/.bin/next", "start", "-p", "3000", "-H", "0.0.0.0"]
